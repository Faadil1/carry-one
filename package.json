  "description": "Carry One — canonical relay service and Nimiq Pay client integration for the W0->W5 technical spike",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo:local": "tsx scripts/demo-local.ts",

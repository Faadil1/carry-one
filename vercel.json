{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/create", "destination": "/index.html" },
    { "source": "/mission/:path*", "destination": "/index.html" },
    { "source": "/i/:path*", "destination": "/index.html" }
  ]
}

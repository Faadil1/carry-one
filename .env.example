NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com
# Prefer two independently operated read endpoints in deployed environments.
# NIMIQ_RPC_URLS=https://rpc-a.example,https://rpc-b.example
NIMIQ_TESTNET_WALLET_ADDRESS=NQ83A24EV6QCJM6U6KFJK6THH0QXHBR837R6
NIMIQ_WATCH_INTERVAL_MS=5000
PORT=8787

# Optional durable local/dev relay state. Keep this path gitignored.
# CARRY_ONE_RELAY_STATE_FILE=.carry-one/relay-state.json
# CARRY_ONE_MISSION_STATE_FILE=.carry-one/mission-state.json

# Reach Mission foundation security keys. Generate two DIFFERENT random 32-byte values,
# encode each as base64url, and keep them only in your deployment/local secret store.
# CARRY_ONE_TARGET_ENCRYPTION_KEY_B64URL=<32-byte-base64url>
# CARRY_ONE_TARGET_HMAC_KEY_B64URL=<different-32-byte-base64url>
# CARRY_ONE_CANONICAL_ORIGIN=https://your-carry-one-origin.example

# Set these only in your local .env when you explicitly want to broadcast the relay test.
# PRIMARY_WALLET_ADDRESS=NQ...
# SECONDARY_WALLET_PRIVATE_KEY_HEX=64_hex_characters
# Or use the generated wallet's mnemonic instead:
# SECONDARY_WALLET_MNEMONIC=twenty four words ...
# CONFIRM_BROADCAST=true
